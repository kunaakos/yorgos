{
    "name": "yorgos",
    "private": true,
    "workspaces": [
        "packages/experimental"
    ],
    "scripts": {
        "format": "prettier --write \"**/{*.ts,*.js,*.json}\"",
        "checks": "npm run check --workspace=@yorgos/experimental",
        "tests": "npm run test --workspace=@yorgos/experimental",
        "builds": "npm run build --workspace=@yorgos/experimental",
        "link-experimental": "npm link --workspace=@yorgos/experimental",
        "unlink-experimental": "npm rm -g @yorgos/experimental"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "6.0.1",
        "@types/node": "24.10.4",
        "prettier": "3.7.4",
        "tsdown": "^0.19.0-beta.2",
        "typescript": "5.9.3"
    }
}
